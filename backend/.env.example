# ============================================================
# SparkOs — Environment Variables  (.env.example)
# Copy to .env and fill in your values
# ============================================================

PORT=3001
NODE_ENV=development

# Public URL of your deployed backend (used in image URLs)
BASE_URL=http://localhost:3001

# OpenAI API Key — powers BOTH prompt enhancement AND image generation
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Default image model: gpt-image-2 | gpt-image-1 | dall-e-3 | dall-e-2
DEFAULT_IMAGE_MODEL=gpt-image-2

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
